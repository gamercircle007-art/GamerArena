# =============================================================================
# GamerCircle / GameConnect Backend — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Environment ---
# local | dev | staging | prod
APP_ENV=local
ENVIRONMENT=local
APP_NAME=gamer-circle
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

# --- Database (Postgres + PostGIS) ---
# Local docker-compose:
DATABASE_URL=postgresql+asyncpg://paythan:changeme_postgres_password@localhost:5432/paythan
# Render injects postgresql://... — auto-normalized to asyncpg + SSL for external hosts
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis (OTP, refresh tokens, presence) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (REQUIRED — min 32 chars) ---
JWT_SECRET_KEY=changeme_use_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth methods ---
AUTH_METHODS=whatsapp_otp,password

# --- OTP ---
OTP_PROVIDER=twilio
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_MINUTES=10
# Local/dev only — fixed OTP bypass. MUST be empty in production (APP_ENV=prod).
OTP_DEV_BYPASS_CODE=123456

# --- Login security ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Argon2 ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- CORS ---
# Local Angular admin: include :4200. Render Blueprint uses * (credentials off).
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080,http://127.0.0.1:4200
CORS_ALLOW_CREDENTIALS=true

# --- Twilio WhatsApp (REQUIRED for real OTP in prod) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# --- Email OTP (future) ---
EMAIL_OTP_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=GamerCircle
EMAIL_USE_TLS=true

# --- Google / Apple OAuth (future) ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_OAUTH_ENABLED=false

# --- AWS S3 / CloudFront (DMS media uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_REGION=ap-south-1

# --- Razorpay (optional payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree PG (preferred for parlor bookings)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_RETURN_URL=gamercircle://payment/return
# CASHFREE_NOTIFY_URL=https://gamer-circle-api.onrender.com/api/v1/payments/webhooks/cashfree

# --- Logging & hosts ---
LOG_LEVEL=INFO
LOG_JSON=false
ALLOWED_HOSTS=*

# --- Boot seed (Render start script) ---
# 1 = ensure admin + seed parlors when empty
SEED_ON_BOOT=1
# 1 = force re-seed even if gaming_places has rows
FORCE_SEED=0

# =============================================================================
# PRODUCTION (Render Dashboard) — set these for gamer-circle-api
# =============================================================================
# APP_ENV=prod
# DEBUG=false
# OTP_DEV_BYPASS_CODE=
# JWT_SECRET_KEY=<generateValue or 32+ random>
# DATABASE_URL=<from gamer-circle-db Internal Database URL>
# REDIS_URL=<from gamer-circle-redis>
# CORS_ORIGINS=*
# ALLOWED_HOSTS=gamer-circle-api.onrender.com,*.onrender.com,localhost
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+1...
# LOG_JSON=true
# LOG_LEVEL=INFO
# SEED_ON_BOOT=1
