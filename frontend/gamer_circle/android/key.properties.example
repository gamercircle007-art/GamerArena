# Copy to key.properties (gitignored) and fill in real values.
# Generate keystore:
#   keytool -genkeypair -v -keystore gamer-circle-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias gamer-circle
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=gamer-circle
storeFile=gamer-circle-upload.jks
